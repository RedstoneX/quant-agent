# Install as a SYSTEM service (not --user) under the dedicated credproxy
# account, since it's a non-interactive service account with no login
# session to keep alive — a plain system unit is simpler than replicating
# qamc's loginctl-linger + systemd --user pattern for no added benefit here.
#
# Install:
#   sudo cp ops/credential-proxy/credential-proxy.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now credential-proxy.service
[Unit]
Description=QAMC credential-injecting HTTPS proxy (real secrets never leave this account)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=credproxy
Group=credproxy
Environment=CREDPROXY_CONFIG=/home/credproxy/routes.json
Environment=CREDPROXY_CA_DIR=/home/credproxy/ca
Environment=CREDPROXY_PORT=10255
ExecStart=/usr/bin/python3 /home/credproxy/gateway.py
Restart=always
RestartSec=5

# Least-privilege sandboxing — this process only needs to read its own
# config/CA directory and talk on the loopback interface.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/credproxy/ca
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
