{
  "openrouter.ai": {
    "upstream_port": 443,
    "rules": [
      {"type": "header", "name": "Authorization", "secret": "OPENROUTER_API_KEY", "format": "Bearer {value}"}
    ]
  },
  "paper-api.alpaca.markets": {
    "upstream_port": 443,
    "rules": [
      {"type": "header", "name": "APCA-API-KEY-ID", "secret": "ALPACA_API_KEY"},
      {"type": "header", "name": "APCA-API-SECRET-KEY", "secret": "ALPACA_SECRET_KEY"}
    ]
  },
  "data.alpaca.markets": {
    "upstream_port": 443,
    "rules": [
      {"type": "header", "name": "APCA-API-KEY-ID", "secret": "ALPACA_API_KEY"},
      {"type": "header", "name": "APCA-API-SECRET-KEY", "secret": "ALPACA_SECRET_KEY"}
    ]
  },
  "api.stlouisfed.org": {
    "upstream_port": 443,
    "rules": [
      {"type": "query_param", "name": "api_key", "secret": "FRED_API_KEY"}
    ]
  },
  "_secrets": {
    "OPENROUTER_API_KEY": "REPLACE-WITH-REAL-VALUE",
    "ALPACA_API_KEY": "REPLACE-WITH-REAL-VALUE",
    "ALPACA_SECRET_KEY": "REPLACE-WITH-REAL-VALUE",
    "FRED_API_KEY": "REPLACE-WITH-REAL-VALUE"
  },
  "_proxy_auth_token": "REPLACE-WITH-RANDOM-TOKEN-setup.sh-generates-this-automatically",
  "_comment": "This is a TEMPLATE. setup.sh installs this and fills in _proxy_auth_token automatically; only _secrets needs manual editing. chmod 600. Never commit the filled-in version — routes.json is gitignored (see ops/credential-proxy/.gitignore). Without a real _proxy_auth_token the proxy refuses to start — any caller without the matching Proxy-Authorization would otherwise get the same access as qamc."
}
