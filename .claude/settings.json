{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(pytest tests/ -q)",
      "Bash(pytest *)",
      "Bash(python -m pytest tests/ -q)",
      "Bash(python -m pytest *)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(git status --short)",
      "Bash(git diff --stat)",
      "Bash(git diff --name-only)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(source .venv/bin/activate)",
      "Bash(git fetch*)",
      "Bash(.venv/bin/python ops/commissioning/verify_commissioning.py *)",
      "Bash(python3 -m py_compile *)",
      "Bash(.venv/bin/python ops/model_policy/benchmark_models.py *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.staging)",
      "Read(./.env.test)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Edit(./.env.development)",
      "Edit(./.env.staging)",
      "Edit(./.env.test)",
      "Edit(./secrets/**)",
      "Edit(./config/credentials.json)"
    ],
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "denyRead": [
        "./.env",
        "./.env.*",
        "./secrets",
        "./config/credentials.json"
      ],
      "allowRead": [
        "./.env.example"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
          }
        ]
      }
    ]
  }
}
