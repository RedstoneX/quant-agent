[Unit]
Description=QAMC Mission Control API/UI (read-only, non-critical to trading)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/qamc/quant-agent
EnvironmentFile=/home/qamc/quant-agent/.env
Environment=QUANT_AGENT_API_HOST=127.0.0.1
Environment=QUANT_AGENT_API_PORT=8800
ExecStart=/home/qamc/quant-agent/.venv/bin/python -m src.api
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
