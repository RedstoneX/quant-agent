# One heartbeat message a week. Its absence is the alarm.
[Unit]
Description=quant-agent weekly alerting heartbeat — Sundays 17:00 ET

[Timer]
# ONCE A WEEK, and no more. A routine "still alive" arriving every morning
# is a message an operator learns to swipe away, and a confirmation nobody
# reads is worth exactly what no confirmation is worth. Weekly keeps it
# legible: one message against roughly 25 session messages a week, on a
# fixed day, with one meaning — the alarm can still reach you.
#
# Sunday, so the operator has Monday morning to fix a dead channel before
# the week's trading opens. 17:00 ET is outside every window in
# SESSION_WINDOWS and falls on a day the market is closed, so it can never
# be mistaken for a trading notification. systemd resolves the IANA zone, so
# this stays 17:00 New York across DST.
#
# Persistent=true matters more here than on any other timer on this box: if
# the box was down on Sunday, the heartbeat MUST still go out late rather
# than not at all. A missed heartbeat and a dead channel look identical from
# the operator's phone, and the whole design depends on them not being.
OnCalendar=Sun 17:00 America/New_York
Persistent=true
AccuracySec=1m

[Install]
WantedBy=timers.target
