# Fires the deploy-drift check EVERY DAY at 08:45 ET.
[Unit]
Description=quant-agent deploy-drift check — daily 08:45 ET

[Timer]
# 08:45 ET is deliberately BEFORE the 09:30 morning session: a merge that
# never reached the box should be caught while there is still time to deploy
# it, not discovered afterwards from the day's decisions. systemd resolves the
# IANA zone, so this stays 08:45 New York across DST.
# EVERY DAY, not Mon-Fri. Changed 2026-09-12 after eleven merges landed on a
# Saturday and the box stayed on Friday's code with nothing to say so — the
# alarm had not failed, it was asleep, and its silence was indistinguishable
# from "the box is current". Code does not stop being merged at the weekend,
# and the gap is exactly when nobody is watching by hand.
OnCalendar=*-*-* 08:45 America/New_York
# Run a missed firing on boot (server was down at 08:45).
Persistent=true

[Install]
WantedBy=timers.target
