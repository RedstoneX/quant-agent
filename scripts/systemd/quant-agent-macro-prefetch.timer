# Fills the FRED series cache ahead of the sessions that read it. Item 119.
[Unit]
Description=quant-agent FRED macro prefetch — 08:45 and 18:30 ET, weekdays

[Timer]
# WHY TWO FIRINGS, AND WHY THESE TWO TIMES. Both are pinned to published
# release clocks and to a MEASURED session start, not chosen for roundness.
#
# 08:45 ET. It must be AFTER 08:30, the slot in which BLS releases its
# principal federal economic indicators — CPI and the Employment Situation,
# i.e. CPIAUCSL, CPILFESL and UNRATE, with initial claims (ICSA) in the same
# slot (bls.gov/schedule/news_release/cpi.htm and .../empsit.htm, read
# 2026-09-23). A prefetch before 08:30 would hold a pre-CPI snapshot on the
# one morning a month the print actually moves the book. It must also finish
# before the morning session reads macro, which the production log puts at
# 09:30:49 ET (13:30:48.283 / 13:30:49.653 / 13:30:49.386 UTC on 2026-09-18,
# 09-21, 09-22 — 49 seconds AFTER the opening bell). The job's own computed
# ceiling is 1020s, so even the gross worst case lands 09:02 ET, 28 minutes
# clear. 08:45 is the only time that satisfies both ends with margin.
#
# 18:30 ET. It must be AFTER 16:15, when the Fed's H.15 Selected Interest
# Rates posts ("daily Monday through Friday at 4:15pm",
# federalreserve.gov/releases/h15/) — that is the print DFF, DGS3MO, DGS2,
# DGS10, DFII10 and T10YIE all come from. It must be before the evening
# session at 20:00 ET. 18:30 is the existing schedule anchor in that gap: it
# is already the second firing of quant-agent-pricing-refresh.timer, chosen
# there for the same reason (between the close session ending 16:00 and the
# evening session starting 20:00), so this adds no new time to the desk's
# schedule.
#
# Together the two firings mean a cached entry is never asked to survive a
# publication boundary: the 08:45 copy serves the morning (09:30) and midday
# (13:00) reads and expires at 16:15; the 18:30 copy serves the evening read.
# That matters because the starvation is NOT an open-only problem. Of the
# seven runs in the retained log that exhausted the 90-second fetch ceiling,
# three were midday (17:02 UTC = 13:02 ET), three were evening (00:02 UTC =
# 20:02 ET) and only one was the morning. Fixing the open alone would have
# left six of seven untouched.
#
# WEEKDAYS ONLY, unlike the pricing refresh. Nothing this job fetches is
# published at a weekend: every boundary above falls on a business day, and
# the only sessions that read the cache are weekday sessions.
OnCalendar=Mon-Fri *-*-* 08:45 America/New_York
OnCalendar=Mon-Fri *-*-* 18:30 America/New_York
# Run a missed firing on boot (the box was down at 08:45).
Persistent=true

[Install]
WantedBy=timers.target
