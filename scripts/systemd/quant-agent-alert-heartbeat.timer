# Proves the alert channel every day, before anything that might need it.
[Unit]
Description=quant-agent alerting-channel self-test — 06:15 ET, seven days a week

[Timer]
# SEVEN DAYS, not Mon-Fri. Alarms fire on days the market is closed: the
# pricing-refresh timer runs 06:30 and 18:30 every day precisely because the
# cache went stale over a weekend with nothing watching. A channel that is
# only proved on weekdays leaves the desk's weekend alarms unbacked.
#
# 06:15 ET is ahead of the first scheduled job of the day (pricing refresh,
# 06:30) and well ahead of the drift check (08:45) and the morning session
# (09:30), so the channel is proved before anything that might need to
# shout. It is outside every window in src/trading_calendar.py's
# SESSION_WINDOWS, so it can never be confused with a trading run. systemd
# resolves the IANA zone, so this stays 06:15 New York across DST.
#
# DAILY, not hourly. The alert path breaks for structural reasons — a
# rotated credential, a deleted chat, a new egress rule — none of which
# arrive on a minute scale. Hourly would multiply Bot API traffic 24x for no
# gain in detecting a structural fault, and would turn every transient
# network blip into a recorded failure. Daily bounds "how long can the alarm
# be dead before the box knows" at 24h, which is shorter than the gap
# between any two consequential alerts this desk raises.
OnCalendar=*-*-* 06:15 America/New_York
# Run a missed firing on boot (the box was down at 06:15).
Persistent=true
# The probe does not care about the exact minute; letting systemd batch this
# with other timers is free.
AccuracySec=1m

[Install]
WantedBy=timers.target
