# Starts quant-agent-auto-fix.service the moment a desk health report finishes.
#
# SHIPPED DISABLED. Do not `enable` this without a deliberate decision — see
# the header of quant-agent-auto-fix.service.
#
# EVENT-DRIVEN, NOT SCHEDULED, and that is the whole point (owner instruction,
# 2026-09-20). An earlier draft of this used a timer set twenty minutes after
# each report's scheduled kickoff. That is a guess about how long a report
# takes: a slow report gets read while it is still being written, and a fast
# one leaves the session idle. The report itself now says when it is done —
# `scripts/run_log_health_report.sh` writes the marker below as its last step,
# after the Telegram send returns, success or failure — and this unit reacts to
# that. There is no clock here at all, so there is no schedule to be wrong.
#
# The marker is a file rather than a direct call because the report runs as the
# trading account `qamc` and this session must run as the engineering account
# `ubuntu`, and `qamc` has no sudo on this box [verified 2026-09-20]. The
# reasoning, and why closing that gap is an owner-only decision, is written at
# the handoff itself in `scripts/run_log_health_report.sh`.
#
# Same mechanism as quant-agent-status-board.path, which already watches files
# under /home/qamc from a unit that reacts to them.
[Unit]
Description=quant-agent auto-fix trigger — watches for a finished desk health report

[Path]
# PathChanged, not PathModified: the report writes a temp file and renames it
# over this one, so the whole handoff lands as a single atomic event and fires
# exactly once per report. PathModified would fire on each partial write.
PathChanged=/var/lib/quant-agent/handoff/health-report-complete
# MakeDirectory is deliberately NOT set. This directory has to be created once,
# by hand, owned by `qamc` and readable by `ubuntu` — see AUTO_FIX_LOOP.md.
# Letting this unit create it would create it owned by `ubuntu`, and then the
# report, running as `qamc`, could never write the marker: the handoff would
# silently never fire and look like a schedule that simply never ran.
Unit=quant-agent-auto-fix.service

[Install]
WantedBy=paths.target
