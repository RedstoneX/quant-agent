# Fires the worktree prune EVERY DAY at 23:30 ET (after trading closes).
[Unit]
Description=quant-agent git worktree prune — daily 23:30 ET

[Timer]
# 23:30 ET runs after-hours, so it will not interfere with any trading
# session. Once daily is sufficient to keep the registry clean without
# imposing any operational overhead. The actual prune operation is instant
# (only processes the registry, does not touch directories).
#
# EVERY DAY, matching the board-hygiene and unit-drift checks — the repo can
# accumulate session scratch at any time, including weekends.
#
# systemd resolves the IANA zone, so this stays 23:30 New York across DST.
OnCalendar=*-*-* 23:30 America/New_York
# Run a missed firing on boot (server was down at 23:30).
Persistent=true
# The comparison does not care about the exact minute; letting systemd
# batch this with late-evening services is free.
AccuracySec=1m

[Install]
WantedBy=timers.target
