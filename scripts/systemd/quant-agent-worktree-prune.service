# Worktree registration hygiene — prune stale session-scratch registrations.
# Pairs with quant-agent-worktree-prune.timer.
#
# Install:
#   cp scripts/systemd/quant-agent-worktree-prune.* ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now quant-agent-worktree-prune.timer
[Unit]
Description=quant-agent git worktree prune (clean stale registrations)

[Service]
Type=oneshot
WorkingDirectory=/home/qamc/quant-agent
# Read-only on the filesystem: reads the git worktree registry and removes
# orphaned entries when their directories no longer exist (the only case
# `git worktree prune` removes). No LLM, no trading, no network. Safe to
# fire regardless of what else is running.
#
# The quant-agent repo stores ~43 session-scratch worktrees under /tmp. When
# sessions finish, their /tmp worktrees are deleted but the git registration
# persists. This timer cleans up those stale registrations once per day,
# keeping the registry honest.
ExecStart=/home/qamc/quant-agent/scripts/run_worktree_prune.sh
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal
