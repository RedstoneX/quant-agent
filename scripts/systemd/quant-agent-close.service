[Unit]
Description=quant-agent close trading session (fires only inside its ET window; self-gated no-op otherwise)

[Service]
Type=oneshot
WorkingDirectory=/home/qamc/quant-agent
ExecStart=/home/qamc/quant-agent/scripts/run_if_et_window.sh close
TimeoutStartSec=1260
StandardOutput=journal
StandardError=journal
