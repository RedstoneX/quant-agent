# The three board documents every parallel branch collides on get merged by
# the item-aware resolver (scripts/resolve_doc_conflict.py), not git's
# default line-level 3-way merge.
#
# This line alone does NOT turn the driver on — a merge driver must also be
# registered per clone (`git config merge.<name>.driver ...`; see README.md
# "### Install" and scripts/git_merge_driver_docs.sh). A clone that has not
# run that command is unaffected: git falls back to its normal conflicted
# merge for these files, same as before this file existed.
docs/WORK.md merge=docsmerge
docs/board_notes/*.md merge=docsmerge
docs/INCIDENT_HISTORY.md merge=docsmerge

# The ratchet history is APPEND-ONLY: two branches that each retire a number
# both append one entry at the end, and union merge keeps both instead of
# raising a conflict on the same last line. See the header of that file.
config/number_ledger_history.yaml merge=union

# The shrink-only ratchet baselines every guard-retiring change edits. Merged
# by scripts/resolve_baseline_conflict.py (min of both sides, drop keys for
# deleted files, REFUSE any merge that would loosen a baseline). Like docsmerge
# this needs the per-clone registration: scripts/install_git_merge_drivers.sh.
tests/import_cycle_baseline.json merge=baselinemerge
tests/import_layers.json merge=baselinemerge
