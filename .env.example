# Copy this file to `.env` and fill in your own keys.
# `.env` is gitignored — do NOT commit your real keys.

# === Required ===

# LLM providers. The codebase routes per-agent via `config/settings.yaml`
# (e.g. `tech_analyst_model: gpt-5.4`). Either provider may be used; both
# are supported by `src/agents/base.py`. You only need keys for the
# providers your settings.yaml actually uses.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Alpaca brokerage. Defaults to paper trading (see config/settings.yaml:
# `alpaca.paper: true`). Get keys at https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=PK...
ALPACA_SECRET_KEY=...

# FRED economic data (free). Used by macro_analyst for VIX, treasury
# yields, Fed funds, CPI, unemployment, HY OAS. Register at
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=...

# QAMC production deployment: same OneCLI mechanism as OPENROUTER_API_KEY
# above — ALPACA_API_KEY/ALPACA_SECRET_KEY/FRED_API_KEY above stay
# placeholders; OneCLI's gateway injects the real values (see
# docs/architecture/CREDENTIAL_DELIVERY_EVIDENCE.md). No code change here
# either — alpaca-py's TradingClient/StockHistoricalDataClient and
# fredapi's Fred() are constructed with no custom session/http_client in
# src/execution/broker.py and src/data/macro.py, so both already inherit
# their library's default environment-driven proxy/CA behavior. One
# addition beyond OPENROUTER_API_KEY's HTTPS_PROXY/SSL_CERT_FILE: Alpaca's
# `requests`-based client does NOT honor SSL_CERT_FILE, only:
# REQUESTS_CA_BUNDLE=/path/to/onecli-gateway-ca.pem  (same CA file as SSL_CERT_FILE)

# === Optional (tuning knobs — leave unset for defaults) ===

# Per-LLM-call retry budget. Default 7 with full positive jitter
# (~140s worst-case window). Bump higher only if you observe sustained
# provider outages exceeding the default window.
# QUANT_AGENT_MAX_RETRIES=7

# DeepSeek — optional; required only if any config/settings.yaml `*_model`
# is a deepseek-* id (see src/agents/base.py's DeepSeek routing notes).
# DEEPSEEK_API_KEY=sk-...

# OpenRouter (Stage 1 QAMC provider/model plumbing) — optional; required
# only if an agent in config/settings.yaml sets `<agent>_provider: openrouter`.
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...
#
# QAMC production deployment: OPENROUTER_API_KEY above stays a placeholder.
# The real key is held only by OneCLI (docs/architecture/CREDENTIAL_DELIVERY_EVIDENCE.md),
# which injects it at the network layer for requests to openrouter.ai. That
# requires no code change — src/agents/base.py's OpenRouter branch already
# constructs its OpenAI SDK client with no custom http_client, so it inherits
# httpx's normal environment-driven proxy/CA behavior. Set (from OneCLI's own
# per-agent container-config, never hardcoded here):
# HTTPS_PROXY=http://x:<agent-token>@127.0.0.1:10255
# SSL_CERT_FILE=/path/to/onecli-gateway-ca.pem

# In-flight call cap for the OpenRouter path specifically (separate from
# QUANT_AGENT_MAX_CONCURRENT_LLM, which caps the OpenAI/relay path only —
# OpenRouter is a distinct account/rate-limit domain). Default 3.
# QUANT_AGENT_MAX_CONCURRENT_OPENROUTER=3

# Stage 2 Mission Control API (`python -m src.api`) — a separate, optional
# read-only process; trading needs none of these. Bind defaults to
# loopback-only (127.0.0.1) since initial remote access is meant to go
# through Tailscale/private networking, not a public bind (DECISIONS.md
# #29). See docs/architecture/MISSION_CONTROL_API.md.
# QUANT_AGENT_API_HOST=127.0.0.1
# QUANT_AGENT_API_PORT=8800
# QUANT_AGENT_API_CONFIG=config/settings.yaml

# Telegram session-status push (opt-in). Every session pushes a structured
# status message — orders, degraded-data flags, daily P&L, or the exception
# trace on failure — to a chat you control. `src/notifier.py` reads these
# from the environment at construction; the systemd/launchd wrappers
# (`scripts/run_if_et_window.sh`, `scripts/run_daily_export.sh`) source your
# `.env`, which is how a scheduled session receives them.
#
# If either of the two is missing the notifier is a silent no-op and trading
# is completely unchanged — Telegram is status output only and can never
# block, delay or alter a trade. Setup steps (BotFather → /start → getUpdates
# for the chat_id) and the per-mode noise policy are in README.md.
#
# Verify delivery without running a trading session:
#   .venv/bin/python scripts/telegram_test.py
#
# Every session now proves this path end to end before it pushes anything
# (one real message, deleted immediately) and records the verdict in SQLite,
# which Mission Control renders as `alert_channel`. So a missing or revoked
# credential is no longer invisible: it shows up RED on the health board
# within about half an hour on a weekday. Read the current verdict with
#   .venv/bin/python scripts/alert_heartbeat.py --status
#
# TELEGRAM_BOT_TOKEN=12345:ABC...
# TELEGRAM_CHAT_ID=987654321
#
# Mute pushes without removing the creds. The Python notifier accepts
# exactly 1 / true / yes (case-insensitive) — anything else, INCLUDING
# `0` and `false`, leaves pushes ON. run_if_et_window.sh's bash-side kill
# notification additionally tolerates `on`, so use one of the three
# spellings above if you want both muted. To un-mute, remove the line;
# setting it to 0 does not work.
#
# While this is set the desk genuinely cannot raise an alarm, so the
# alert-channel watchdog reports the channel BROKEN and Mission Control goes
# red. That is deliberate — a mute rendered as healthy is the same lie in a
# friendlier costume — so expect a red health board for as long as it is on.
# TELEGRAM_DISABLED=1
