# Copy this file to `.env` and fill in your own keys.
# `.env` is gitignored — do NOT commit your real keys.

# === Required ===

# LLM providers. The codebase routes per-agent via `config/settings.yaml`
# (e.g. `tech_analyst_model: gpt-5.4`). Either provider may be used; both
# are supported by `src/agents/base.py`. You only need keys for the
# providers your settings.yaml actually uses.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Alpaca brokerage. Defaults to paper trading (see config/settings.yaml:
# `alpaca.paper: true`). Get keys at https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=PK...
ALPACA_SECRET_KEY=...

# FRED economic data (free). Used by macro_analyst for VIX, treasury
# yields, Fed funds, CPI, unemployment, HY OAS. Register at
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=...

# === Optional (tuning knobs — leave unset for defaults) ===

# Per-LLM-call retry budget. Default 7 with full positive jitter
# (~140s worst-case window). Bump higher only if you observe sustained
# provider outages exceeding the default window.
# QUANT_AGENT_MAX_RETRIES=7

# DeepSeek — optional; required only if any config/settings.yaml `*_model`
# is a deepseek-* id (see src/agents/base.py's DeepSeek routing notes).
# DEEPSEEK_API_KEY=sk-...

# OpenRouter (Stage 1 QAMC provider/model plumbing) — optional; required
# only if an agent in config/settings.yaml sets `<agent>_provider: openrouter`.
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...
#
# QAMC production deployment: OPENROUTER_API_KEY above stays a placeholder.
# The real key is held only by OneCLI (docs/architecture/CREDENTIAL_DELIVERY_EVIDENCE.md),
# which injects it at the network layer for requests to openrouter.ai. That
# requires no code change — src/agents/base.py's OpenRouter branch already
# constructs its OpenAI SDK client with no custom http_client, so it inherits
# httpx's normal environment-driven proxy/CA behavior. Set (from OneCLI's own
# per-agent container-config, never hardcoded here):
# HTTPS_PROXY=http://x:<agent-token>@127.0.0.1:10255
# SSL_CERT_FILE=/path/to/onecli-gateway-ca.pem

# In-flight call cap for the OpenRouter path specifically (separate from
# QUANT_AGENT_MAX_CONCURRENT_LLM, which caps the OpenAI/relay path only —
# OpenRouter is a distinct account/rate-limit domain). Default 3.
# QUANT_AGENT_MAX_CONCURRENT_OPENROUTER=3

# Stage 2 Mission Control API (`python -m src.api`) — a separate, optional
# read-only process; trading needs none of these. Bind defaults to
# loopback-only (127.0.0.1) since initial remote access is meant to go
# through Tailscale/private networking, not a public bind (DECISIONS.md
# #29). See docs/architecture/MISSION_CONTROL_API.md.
# QUANT_AGENT_API_HOST=127.0.0.1
# QUANT_AGENT_API_PORT=8800
# QUANT_AGENT_API_CONFIG=config/settings.yaml
